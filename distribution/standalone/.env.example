# OpenScope V0.1 — .env template. Copy to .env and set secrets BEFORE `openscope start`.
# .env is git-ignored; never commit real passwords.
#
# Grafana admin credentials (MUST differ from defaults or start refuses to run)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-strong-password

# Host port for Grafana. Default profile: 3000. Dev-machine validation profile: 13001
# (3000 is occupied by an existing service on the shared dev host).
GRAFANA_PORT=3000

# BOM pins — resolved by tools/resolve-bom.sh into distribution/bom.yaml.
# Engine substitutes OPEN_SCOPE_BOM_* variables at compose time (see .env + cli/openscope).
OPEN_SCOPE_BOM_OTELCOL=0.159.0
OPEN_SCOPE_BOM_OTELCOL_DIGEST=
OPEN_SCOPE_BOM_PROMETHEUS=v3.14.0
OPEN_SCOPE_BOM_PROMETHEUS_DIGEST=
OPEN_SCOPE_BOM_TEMPO=3.0.3
OPEN_SCOPE_BOM_TEMPO_DIGEST=
OPEN_SCOPE_BOM_LOKI=3.7.6
OPEN_SCOPE_BOM_LOKI_DIGEST=
OPEN_SCOPE_BOM_GRAFANA=13.2.0
OPEN_SCOPE_BOM_GRAFANA_DIGEST=