#!/usr/bin/env bash
# OpenScope V0.1 CLI — start | stop | status | doctor | version
# Fail-closed: any confirmed dependency failure exits non-zero.
set -euo pipefail

# --- locate repo root & scripts -------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
DIST_DIR="$ROOT_DIR/distribution"
STANDALONE_DIR="$DIST_DIR/standalone"
COMPOSE_FILE="$STANDALONE_DIR/docker-compose.yml"
ENV_FILE="$STANDALONE_DIR/.env"
BOM_FILE="$DIST_DIR/bom.yaml"
PROJECT="openscope-v01"

log()  { printf '\033[1;32m[openscope]\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m[openscope] ERROR:\033[0m %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

# --- BOM helpers ----------------------------------------------------------------
bom_get() { # bom_get <image-key> <field>
  local key="$1" field="$2"
  awk -v k="^  $key:" -v f="^    $field:" '$0 ~ k {on=1; next} on && /^  [a-z]/ {on=0} on && $0 ~ f {sub(/^[[:space:]]*[^:]*:[[:space:]]*/, ""); print; exit}' "$BOM_FILE"
}

load_bom_env() {
  [ -f "$BOM_FILE" ] || die "BOM file not found: $BOM_FILE"
  export OPEN_SCOPE_BOM_OTELCOL="$(bom_get otelcol-contrib tag)"
  export OPEN_SCOPE_BOM_OTELCOL_DIGEST="$(bom_get otelcol-contrib digest)"
  export OPEN_SCOPE_BOM_PROMETHEUS="$(bom_get prometheus tag)"
  export OPEN_SCOPE_BOM_PROMETHEUS_DIGEST="$(bom_get prometheus digest)"
  export OPEN_SCOPE_BOM_TEMPO="$(bom_get tempo tag)"
  export OPEN_SCOPE_BOM_TEMPO_DIGEST="$(bom_get tempo digest)"
  export OPEN_SCOPE_BOM_LOKI="$(bom_get loki tag)"
  export OPEN_SCOPE_BOM_LOKI_DIGEST="$(bom_get loki digest)"
  export OPEN_SCOPE_BOM_GRAFANA="$(bom_get grafana tag)"
  export OPEN_SCOPE_BOM_GRAFANA_DIGEST="$(bom_get grafana digest)"
  export OPEN_SCOPE_BOM_QUERY_CURL="$(bom_get query-curl tag)"
  export OPEN_SCOPE_BOM_QUERY_CURL_DIGEST="$(bom_get query-curl digest)"
  export OPEN_SCOPE_QUERY_IMAGE="curlimages/curl:$OPEN_SCOPE_BOM_QUERY_CURL@$OPEN_SCOPE_BOM_QUERY_CURL_DIGEST"
  for v in OPEN_SCOPE_BOM_OTELCOL_DIGEST OPEN_SCOPE_BOM_PROMETHEUS_DIGEST OPEN_SCOPE_BOM_TEMPO_DIGEST OPEN_SCOPE_BOM_LOKI_DIGEST OPEN_SCOPE_BOM_GRAFANA_DIGEST OPEN_SCOPE_BOM_QUERY_CURL_DIGEST; do
    [ -n "${!v}" ] || die "BOM digest missing for $v — run ./tools/resolve-bom.sh first (AC-A2 gate)"
  done
}

load_env() {
  [ -f "$ENV_FILE" ] || die ".env missing at $ENV_FILE — copy distribution/standalone/.env.example to .env and set GF_ADMIN_PASSWORD (AC-C5)"
  # shellcheck disable=SC1090
  set -a; source "$ENV_FILE"; set +a
  local pw="${GF_ADMIN_PASSWORD:-}"
  case "$pw" in
    ""|admin|change-me-strong-password)
      die "GF_ADMIN_PASSWORD must be a non-default secret (AC-C5)" ;;
  esac
  export GRAFANA_PORT="${GRAFANA_PORT:-3000}"
}

check_docker() {
  command -v docker >/dev/null 2>&1 || die "docker not found"
  docker info >/dev/null 2>&1 || die "docker daemon not reachable"
  docker compose version >/dev/null 2>&1 || die "docker compose plugin not available"
}

check_ports() {
  # start is idempotent (AC-C2): ports already bound by THIS project's own
  # running containers are ours and must not be treated as a conflict.
  local p
  for p in 4317 4318 "$GRAFANA_PORT"; do
    if docker ps --format '{{.Names}}\t{{.Ports}}' 2>/dev/null | \
         grep -Eq "^$PROJECT-.*(:|-)${p}(->|-)"; then
      continue
    fi
    if lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1 || \
       (command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q ":$p "); then
      die "port $p already in use by a foreign process (AC-C4/C6)"
    fi
  done
}

check_disk() {
  local stats avail_gi use_pct
  if command -v df >/dev/null 2>&1; then
    stats="$(disk_stats)"
    read -r avail_gi use_pct <<< "$stats"
    if [ "$avail_gi" -lt 10 ] || [ "$use_pct" -ge 90 ]; then
      die "workspace disk guard ($STANDALONE_DIR): available=${avail_gi}GiB (<10) or usage=${use_pct}% (>=90)"
    fi
  fi
}

disk_stats() {
  df -kP "$STANDALONE_DIR" | awk 'NR==2 {gsub("%","",$5); printf "%d %d", $4/1024/1024, $5}'
}

file_mode() {
  if stat -f '%Lp' "$1" >/dev/null 2>&1; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

compose_cmd() {
  docker compose --project-name "$PROJECT" -f "$COMPOSE_FILE" "$@"
}

# --- commands --------------------------------------------------------------------
cmd_start() {
  check_docker; load_env; load_bom_env; check_disk; check_ports
  mkdir -p "$STANDALONE_DIR/.data"
  compose_cmd up -d --remove-orphans
  log "stack started: collector prometheus tempo loki grafana"
}

cmd_stop() {
  check_docker   # stop is a cleanup action: no disk/port guard (AC-G4/C6 fail semantics preserved)
  if [ -f "$BOM_FILE" ]; then load_bom_env; fi
  compose_cmd stop 2>/dev/null || true   # idempotent; never deletes data volumes
  log "stack stopped (volumes preserved — AC-G4)"
}

cmd_status() {
  check_docker
  if [ -f "$BOM_FILE" ]; then load_bom_env; fi
  compose_cmd ps 2>/dev/null || true
  echo "---"
  docker ps --filter "label=com.docker.compose.project=$PROJECT" --format 'table {{.Names}}\t{{.Status}}'
}

cmd_doctor() {
  local rc=0 query_image grafana_url gid uid response mode stats avail_gi use_pct svc backend mount_mode running_image expected_image grafana_code grafana_auth_failed
  check_docker
  load_env
  load_bom_env
  query_image="${OPEN_SCOPE_QUERY_IMAGE:-curlimages/curl:8.10.1}"
  grafana_url="http://127.0.0.1:$GRAFANA_PORT"

  doctor_ok() { echo "  OK   $*"; }
  doctor_fail() { echo "  FAIL $*"; rc=1; }
  internal_get() {
    docker run --rm --network "${PROJECT}_openscope-net" --entrypoint /bin/sh \
      "$query_image" -c 'curl -fsS --connect-timeout 3 --max-time 8 "$1" >/dev/null' sh "$1" 2>/dev/null
  }

  echo "[doctor] component health:"
  for svc in collector prometheus tempo loki grafana; do
    if docker ps --format '{{.Names}}' | grep -q "^$PROJECT-$svc\$"; then
      doctor_ok "$svc container running"
    else
      doctor_fail "$svc container not running"
    fi
  done

  echo "[doctor] backend readiness:"
  for spec in \
    'collector|http://collector:13133/' \
    'prometheus|http://prometheus:9090/-/ready' \
    'tempo|http://tempo:3200/ready' \
    'loki|http://loki:3100/ready'; do
    svc="${spec%%|*}"; url="${spec#*|}"; ready=0
    if ! docker ps --format '{{.Names}}' | grep -q "^$PROJECT-$svc\$"; then
      doctor_fail "$svc API skipped because container is not running"
      continue
    fi
    for _ in $(seq 1 12); do
      if internal_get "$url"; then ready=1; break; fi
      sleep 2
    done
    [ "$ready" -eq 1 ] && doctor_ok "$svc API ready" || doctor_fail "$svc API not ready"
  done

  echo "[doctor] OTLP listeners:"
  if curl -sS --connect-timeout 3 --max-time 5 -o /dev/null "http://127.0.0.1:4318/" 2>/dev/null; then
    doctor_ok "OTLP/HTTP 127.0.0.1:4318 reachable"
  else
    doctor_fail "OTLP/HTTP 127.0.0.1:4318 unreachable"
  fi
  if (exec 3<>/dev/tcp/127.0.0.1/4317) 2>/dev/null; then
    exec 3>&- 3<&-
    doctor_ok "OTLP/gRPC 127.0.0.1:4317 reachable"
  else
    doctor_fail "OTLP/gRPC 127.0.0.1:4317 unreachable"
  fi

  echo "[doctor] Grafana and provisioned assets:"
  gid=$(docker ps --format '{{.Names}}' | grep "^$PROJECT-grafana\$" || true)
  if [ -n "$gid" ]; then
    gready=0; grafana_auth_failed=0
    for _ in $(seq 1 30); do
      grafana_code="$(curl -sS -o /dev/null -w '%{http_code}' \
        -u "${GF_ADMIN_USER:-admin}:${GF_ADMIN_PASSWORD:-}" \
        -H "Accept: application/json" "$grafana_url/api/user" 2>/dev/null || true)"
      case "$grafana_code" in
        200) gready=1; break ;;
        401) grafana_auth_failed=1; break ;;
        *) sleep 2 ;;
      esac
    done
    if [ "$gready" -eq 1 ]; then
      doctor_ok "grafana authenticated API ready"
    elif [ "$grafana_auth_failed" -eq 1 ]; then
      doctor_fail "grafana API authentication failed"
    else
      doctor_fail "grafana authenticated API unreachable"
    fi
    if [ "$gready" -eq 1 ]; then
      for uid in openscope-prometheus openscope-tempo openscope-loki; do
        backend="${uid#openscope-}"
        if ! docker ps --format '{{.Names}}' | grep -q "^$PROJECT-$backend\$"; then
          doctor_fail "datasource $uid health skipped because $backend is not running"
          continue
        fi
        dready=0
        for _ in $(seq 1 30); do
          response="$(curl -sf -u "${GF_ADMIN_USER:-admin}:${GF_ADMIN_PASSWORD:-}" \
               "$grafana_url/api/datasources/uid/$uid/health" 2>/dev/null || true)"
          if printf '%s' "$response" | grep -Eq '"status"[[:space:]]*:[[:space:]]*"(OK|ok|success)"'; then
            dready=1; break
          fi
          sleep 2
        done
        [ "$dready" -eq 1 ] && doctor_ok "datasource $uid health" || doctor_fail "datasource $uid health"
      done
      ok=0
      for _ in $(seq 1 30); do
        if curl -sf -u "${GF_ADMIN_USER:-admin}:${GF_ADMIN_PASSWORD:-}" \
             "$grafana_url/api/search?query=OpenScope%20Overview" 2>/dev/null | grep -q openscope-overview; then
          ok=1; break
        fi
        sleep 2
      done
      if [ "$ok" -eq 1 ]; then
        doctor_ok "dashboard openscope-overview provisioned"
      else
        doctor_fail "dashboard openscope-overview not found"
      fi
    else
      doctor_fail "datasource and dashboard checks skipped because Grafana authentication is unavailable"
    fi
  else
    doctor_fail "grafana API skipped because container is not running"
    doctor_fail "datasource and dashboard checks skipped because Grafana is not running"
  fi

  echo "[doctor] permissions, storage and BOM:"
  mode="$(file_mode "$ENV_FILE")"
  case "$mode" in
    400|600) doctor_ok ".env permissions $mode" ;;
    *) doctor_fail ".env permissions $mode (expected 400 or 600)" ;;
  esac
  if [ -d "$STANDALONE_DIR/.data" ] && [ -w "$STANDALONE_DIR/.data" ]; then
    doctor_ok "runtime data directory writable"
  else
    doctor_fail "runtime data directory missing or not writable"
  fi
  for svc in prometheus tempo loki grafana; do
    mount_mode="$(docker inspect --format '{{range .Mounts}}{{if eq .Type "volume"}}{{if .RW}}rw{{else}}ro{{end}}{{end}}{{end}}' "$PROJECT-$svc" 2>/dev/null || true)"
    printf '%s' "$mount_mode" | grep -q rw \
      && doctor_ok "$svc data volume writable" \
      || doctor_fail "$svc data volume not writable"
  done
  for spec in \
    "collector|ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib:$OPEN_SCOPE_BOM_OTELCOL@$OPEN_SCOPE_BOM_OTELCOL_DIGEST" \
    "prometheus|prom/prometheus:$OPEN_SCOPE_BOM_PROMETHEUS@$OPEN_SCOPE_BOM_PROMETHEUS_DIGEST" \
    "tempo|grafana/tempo:$OPEN_SCOPE_BOM_TEMPO@$OPEN_SCOPE_BOM_TEMPO_DIGEST" \
    "loki|grafana/loki:$OPEN_SCOPE_BOM_LOKI@$OPEN_SCOPE_BOM_LOKI_DIGEST" \
    "grafana|grafana/grafana:$OPEN_SCOPE_BOM_GRAFANA@$OPEN_SCOPE_BOM_GRAFANA_DIGEST"; do
    svc="${spec%%|*}"; expected_image="${spec#*|}"
    running_image="$(docker inspect --format '{{.Config.Image}}' "$PROJECT-$svc" 2>/dev/null || true)"
    [ "$running_image" = "$expected_image" ] \
      && doctor_ok "$svc image matches BOM" \
      || doctor_fail "$svc image does not match BOM"
  done
  stats="$(disk_stats)"; read -r avail_gi use_pct <<< "$stats"
  if [ "$avail_gi" -ge 10 ] && [ "$use_pct" -lt 90 ]; then
    doctor_ok "workspace disk available=${avail_gi}GiB usage=${use_pct}%"
  else
    doctor_fail "workspace disk available=${avail_gi}GiB usage=${use_pct}%"
  fi
  [ "$rc" -eq 0 ] && echo "[doctor] ALL OK" || echo "[doctor] FAILURES DETECTED (exit $rc)"
  exit "$rc"
}

cmd_version() {
  if [ ! -f "$BOM_FILE" ]; then
    die "BOM file not found: $BOM_FILE"
  fi
  load_bom_env
  cat <<EOF
OpenScope distribution v0.1.0
  collector: $OPEN_SCOPE_BOM_OTELCOL@${OPEN_SCOPE_BOM_OTELCOL_DIGEST}
  prometheus: $OPEN_SCOPE_BOM_PROMETHEUS@${OPEN_SCOPE_BOM_PROMETHEUS_DIGEST}
  tempo: $OPEN_SCOPE_BOM_TEMPO@${OPEN_SCOPE_BOM_TEMPO_DIGEST}
  loki: $OPEN_SCOPE_BOM_LOKI@${OPEN_SCOPE_BOM_LOKI_DIGEST}
  grafana: $OPEN_SCOPE_BOM_GRAFANA@${OPEN_SCOPE_BOM_GRAFANA_DIGEST}
  query helper: $OPEN_SCOPE_QUERY_IMAGE
EOF
}

# --- main -------------------------------------------------------------------------
case "${1:-}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  status)  cmd_status ;;
  doctor)  cmd_doctor ;;
  version) cmd_version ;;
  *) cat <<EOF
OpenScope V0.1 CLI
usage: $0 {start|stop|status|doctor|version}
EOF
     exit 2 ;;
esac
